# Shared PostgreSQL database connection (Local PostgreSQL or Supabase)
# For Local Postgres:
# DATABASE_URL="postgresql://username:password@localhost:5432/medviaduct?schema=public"
# For Supabase (Transaction Pooler - port 6543):
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# For Supabase (Direct Connection - port 5432):
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"
DATABASE_URL="postgresql://username:password@localhost:5432/medviaduct?schema=public"

# Supabase Auth Configuration (When Member 2 uses Supabase Auth)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Security Host Port
PORT=3001

# Environment
NODE_ENV=development

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Allowed Origin
CORS_ORIGIN="http://localhost:3000"


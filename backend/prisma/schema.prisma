generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Role {
  DOCTOR
  RESEARCHER
  ADMIN
  PATIENT
}
enum Sex {
  FEMALE
  MALE
  INTERSEX
  NOT_SPECIFIED
}
enum EvidenceType {
  CASE
  RESEARCH
  GUIDELINE
  TREND
}

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  profession String
  organization String
  role Role @default(DOCTOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cases ClinicalCase[]
  savedResearch SavedResearch[]
  notifications Notification[]
  qrShares QrShare[]
}

model ClinicalCase {
  id String @id @default(cuid())
  userId String
  title String
  age Int?
  sex Sex @default(NOT_SPECIFIED)
  symptoms Json
  medicalHistory String @default("")
  examinationFindings String @default("")
  labResults String @default("")
  imagingFindings String @default("")
  medications String @default("")
  observations String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis CaseAnalysis?
  similarCases SimilarCase[]
  evidence Evidence[]
}

model CaseAnalysis {
  id String @id @default(cuid())
  caseId String @unique
  summary String
  entities Json
  symptoms Json
  conditions Json
  investigations Json
  keywords Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clinicalCase ClinicalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model SimilarCase {
  id String @id @default(cuid())
  clinicalCaseId String
  title String
  condition String
  similarityScore Float
  keySymptoms Json
  investigations String
  outcome String
  publicationYear Int
  source String
  citation String
  clinicalCase ClinicalCase @relation(fields: [clinicalCaseId], references: [id], onDelete: Cascade)
}

model ResearchPaper {
  id String @id @default(cuid())
  title String
  authors String
  journal String
  publicationDate DateTime
  abstract String
  category String
  disease String
  relevanceScore Float
  source String
  externalUrl String @unique
  citation String
  evidence Evidence[]
  savedBy SavedResearch[]
}

model DiseaseTrend {
  id String @id @default(cuid())
  disease String
  region String
  activity Int
  trend String
  recentCases Int
  alertLevel String
  latitude Float
  longitude Float
  evidence Evidence[]
}

model Evidence {
  id String @id @default(cuid())
  clinicalCaseId String?
  researchPaperId String?
  diseaseTrendId String?
  type EvidenceType
  title String
  source String
  url String
  citation String
  relevance Float
  createdAt DateTime @default(now())
  clinicalCase ClinicalCase? @relation(fields: [clinicalCaseId], references: [id], onDelete: Cascade)
  researchPaper ResearchPaper? @relation(fields: [researchPaperId], references: [id], onDelete: Cascade)
  diseaseTrend DiseaseTrend? @relation(fields: [diseaseTrendId], references: [id], onDelete: Cascade)
}

model SavedResearch {
  id String @id @default(cuid())
  userId String
  researchPaperId String
  savedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  researchPaper ResearchPaper @relation(fields: [researchPaperId], references: [id], onDelete: Cascade)
  @@unique([userId, researchPaperId])
}

model Notification {
  id String @id @default(cuid())
  userId String
  title String
  body String
  read Boolean @default(false)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model QrShare {
  id String @id @default(cuid())
  token String @unique
  userId String
  resourceType String
  resourceId String
  accessType String
  expiresAt DateTime?
  isActive Boolean @default(true)
  scanCount Int @default(0)
  lastScannedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

# ==============================================================================
# Medviaduct - Server-Side Environment Variables & n8n Integration Configuration
# ==============================================================================
#
# IMPORTANT SECURITY NOTICE:
# 1. Never prefix secrets with VITE_ or NEXT_PUBLIC_ to prevent bundling them into the frontend.
# 2. Never commit actual secret values to source control. Real credentials must go in .env or .env.local.
# 3. This file is a template. Copy it to .env (which is strictly ignored by git):
#      cp .env.example .env
#

# ------------------------------------------------------------------------------
# 1. Patient Profile Access Notification Webhook (Goal 1)
# ------------------------------------------------------------------------------
# Production Webhook URL from your published n8n workflow:
# "Medviaduct - Patient Profile Access Notification"
# In n8n, copy the URL from the Webhook node under "Production URL" (HTTP Method: POST)
N8N_PATIENT_ACCESS_WEBHOOK_URL=https://kepler422b.app.n8n.cloud/webhook/medviaduct/patient-access-notification

# ------------------------------------------------------------------------------
# 2. Medicine Refill Request Webhook (Goal 2)
# ------------------------------------------------------------------------------
# Production Webhook URL for the pharmacy refill request workflow.
# Note: If the refill workflow has not been created yet in n8n, leave this blank.
# The backend will persist refill requests safely and skip the webhook until this is configured.
N8N_REFILL_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 3. n8n Header Auth Shared Secret
# ------------------------------------------------------------------------------
# The shared secret configured in your n8n "Header Auth" credential.
# Medviaduct sends this secret in HTTP headers for every webhook dispatch.
N8N_WEBHOOK_SECRET=a238c02e9bcad204f32f3b648531aab73d0c2fe32ab548c6ce84170202a2cb0b

# ------------------------------------------------------------------------------
# 4. Optional Customizations & Development Overrides
# ------------------------------------------------------------------------------
# Name of the HTTP header configured in n8n Header Auth (defaults to X-Medviaduct-Secret)
# Note: In your n8n Header Auth credential, set Name to "X-Medviaduct-Secret"
N8N_HEADER_AUTH_NAME=X-Medviaduct-Secret

# Optional override: Send patient access notification emails to this test address
# instead of the mock demo patient addresses (ananya.deshmukh@medviaduct.org):
# VERIFIED_PATIENT_EMAIL=your-email@example.com

# Optional override: Send pharmacy refill request emails to this test address
# instead of the server-authoritative mock dispensary address:
# N8N_PHARMACY_NOTIFICATION_EMAIL=your-pharmacy-inbox@example.com
